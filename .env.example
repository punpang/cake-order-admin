# คัดลอกเป็น .env.local (ไม่ถูก commit) · บน Vercel ตั้งใน Project Settings → Environment Variables
VITE_USE_SUPABASE=0
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# publishable (anon) key เท่านั้น — ห้ามใช้ service_role
VITE_SUPABASE_ANON_KEY=

# Worker punpang-files (R2) — ว่าง = ใช้ Supabase Storage เดิม
VITE_FILES_URL=
